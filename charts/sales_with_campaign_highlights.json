{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Sales Velocity with Campaign Highlights",
  "width": 1000,
  "height": 400,
  "layer": [
    {
      "data": {
        "values": [
          {"start": "2025-11-24", "end": "2025-12-02", "campaign": "Black Friday"},
          {"start": "2026-03-15", "end": "2026-04-21", "campaign": "Easter Special"}
        ]
      },
      "mark": {"type": "rect", "opacity": 0.15},
      "encoding": {
        "x": {"field": "start", "type": "temporal"},
        "x2": {"field": "end"},
        "color": {"field": "campaign", "type": "nominal", "scale": {"scheme": "set2"}}
      }
    },
    {
      "mark": {"type": "line", "point": true, "color": "#5B5BFF", "size": 3},
      "encoding": {
        "x": {"field": "order_date_month", "type": "temporal", "title": "Date"},
        "y": {"field": "total_revenue", "type": "quantitative", "title": "Revenue ($)", "axis": {"format": "$,.0f"}},
        "tooltip": [
          {"field": "order_date_month", "type": "temporal", "format": "%B %Y", "title": "Date"},
          {"field": "total_revenue", "type": "quantitative", "format": "$,.2f", "title": "Revenue"}
        ]
      }
    }
  ],
  "config": {"axis": {"labelFontSize": 11}}
}
