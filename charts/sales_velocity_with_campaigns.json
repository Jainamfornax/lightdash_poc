{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Sales Velocity Trend",
  "width": 1000,
  "height": 400,
  "data": {
    "url": "data-url"
  },
  "layer": [
    {
      "mark": "rect",
      "data": {
        "values": [
          {
            "start": "2025-11-24",
            "end": "2025-12-02",
            "campaign": "Black Friday"
          },
          {
            "start": "2026-03-15",
            "end": "2026-04-21",
            "campaign": "Easter Special"
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "temporal"
        },
        "x2": {
          "field": "end"
        },
        "color": {
          "value": "#f4e8ff",
          "legend": null
        },
        "opacity": {
          "value": 0.5
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "point": true,
        "color": "#5B5BFF",
        "size": 2,
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "order_date",
          "type": "temporal",
          "title": "Date"
        },
        "y": {
          "field": "total_revenue",
          "type": "quantitative",
          "title": "Revenue",
          "format": "$,.0f"
        },
        "tooltip": [
          {
            "field": "order_date",
            "type": "temporal",
            "title": "Date"
          },
          {
            "field": "total_revenue",
            "type": "quantitative",
            "title": "Revenue",
            "format": "$,.2f"
          }
        ]
      }
    }
  ],
  "config": {
    "axisLeft": {
      "labelExpr": "format(datum.value, '$,.0f')"
    }
  }
}
