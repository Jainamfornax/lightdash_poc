{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Sales Velocity Trend",
  "width": 1000,
  "height": 400,
  "mark": {
    "type": "line",
    "point": true,
    "color": "#5B5BFF",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "order_date_month",
      "type": "temporal",
      "title": "Date"
    },
    "y": {
      "field": "total_revenue",
      "type": "quantitative",
      "title": "Revenue",
      "axis": {
        "format": "$,.0f"
      }
    },
    "tooltip": [
      {
        "field": "order_date_month",
        "type": "temporal",
        "title": "Date",
        "format": "%B %Y"
      },
      {
        "field": "total_revenue",
        "type": "quantitative",
        "title": "Revenue",
        "format": "$,.2f"
      }
    ]
  },
  "config": {
    "axis": {
      "labelFontSize": 11
    }
  }
}
